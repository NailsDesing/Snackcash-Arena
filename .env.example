# Porta do Servidor Node.js
PORT=3000

# URL do Frontend (para CORS em produção)
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# SUPABASE
# Obtenha em: Supabase Dashboard -> Project Settings -> API
# ==============================================================================
SUPABASE_URL=https://your-project.supabase.co
# Use a SERVICE_ROLE_KEY no backend para operações com saldo seguro e Webhooks
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Anon key pública (usada pelo frontend se necessário)
SUPABASE_ANON_KEY=your-supabase-anon-key

# ==============================================================================
# ==============================================================================

# ==============================================================================
# ADMIN PANEL
# Use uma chave longa e aleatória, nunca um valor fixo público.
# ==============================================================================
ADMIN_SECRET_KEY=change-this-to-a-long-random-secret

# Dinheiro real permanece bloqueado até revisão jurídica e homologação técnica.
PAYMENTS_ENABLED=false
WITHDRAWALS_ENABLED=false
ENABLE_DEMO_CREDITS=false
ALLOW_MOCK_AUTH=false
NODE_ENV=development
PAYMENT_WEBHOOK_SECRET=
